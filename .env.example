PORT=3000
NODE_ENV=development

# PostgreSQL / Supabase
DATABASE_URL=postgresql://postgres:TU_PASSWORD@TU_HOST:5432/postgres

# Cambia esto por una cadena larga y secreta
SESSION_SECRET=cambia-esta-clave-por-una-muy-larga-y-segura

# Supabase Storage (solo backend; NUNCA expongas SERVICE_ROLE_KEY al navegador)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
SUPABASE_BUCKET=product-images

# Usuario administrador inicial para npm run seed:admin
ADMIN_NAME=Administrador
