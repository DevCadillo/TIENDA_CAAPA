<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Iniciar sesión | TIENDA CAAPA</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/app.css"
    >

</head>


<body class="login-body">

    <div class="login-background">

        <div class="login-orb login-orb-1"></div>
        <div class="login-orb login-orb-2"></div>

    </div>


    <main class="login-wrapper">

        <div class="login-card">

            <!-- PARTE IZQUIERDA -->
            <div class="login-brand-panel">

                <div class="login-brand-content">

                    <div class="login-logo">
                        🛒
                    </div>

                    <h1>
                        TIENDA CAAPA
                    </h1>

                    <p class="login-brand-subtitle">
                        Sistema de Gestión de Inventario
                    </p>

                    <div class="login-divider"></div>

                    <p class="login-description">
                        Administra productos, precios,
                        stock y disponibilidad desde
                        un solo lugar.
                    </p>


                    <div class="login-features">

                        <div class="login-feature">
                            <span>✓</span>
                            Control de inventario
                        </div>

                        <div class="login-feature">
                            <span>✓</span>
                            Gestión de precios
                        </div>

                        <div class="login-feature">
                            <span>✓</span>
                            Seguimiento de stock
                        </div>

                    </div>

                </div>

            </div>


            <!-- PARTE DERECHA -->
            <div class="login-form-panel">

                <div class="login-form-content">

                    <div class="mb-4">

                        <span class="login-small-title">
                            BIENVENIDO
                        </span>

                        <h2 class="login-title">
                            Iniciar sesión
                        </h2>

                        <p class="login-subtitle">
                            Ingresa tus credenciales para
                            acceder al sistema.
                        </p>

                    </div>


                    <% if(typeof error !== 'undefined' && error){ %>

                        <div
                            class="alert alert-danger login-alert"
                            role="alert"
                        >

                            <strong>
                                No se pudo iniciar sesión.
                            </strong>

                            <div>
                                <%= error %>
                            </div>

                        </div>

                    <% } %>


                    <form
                        method="post"
                        action="/login"
                        class="login-form"
                    >

                        <!-- CORREO -->
                        <div class="mb-3">

                            <label
                                for="email"
                                class="form-label login-label"
                            >
                                Correo electrónico
                            </label>

                            <div class="login-input-group">

                                <span class="login-input-icon">
                                    ✉
                                </span>

                                <input
                                    id="email"
                                    name="email"
                                    type="email"
                                    class="form-control login-input"
                                    placeholder="usuario@tienda.com"
                                    autocomplete="email"
                                    required
                                    autofocus
                                >

                            </div>

                        </div>


                        <!-- CONTRASEÑA -->
                        <div class="mb-4">

                            <label
                                for="password"
                                class="form-label login-label"
                            >
                                Contraseña
                            </label>

                            <div class="login-input-group">

                                <span class="login-input-icon">
                                    🔒
                                </span>

                                <input
                                    id="password"
                                    name="password"
                                    type="password"
                                    class="form-control login-input"
                                    placeholder="Ingresa tu contraseña"
                                    autocomplete="current-password"
                                    required
                                >

                                <button
                                    type="button"
                                    class="password-toggle"
                                    id="togglePassword"
                                    aria-label="Mostrar contraseña"
                                >
                                    👁
                                </button>

                            </div>

                        </div>


                        <!-- BOTÓN -->
                        <button
                            type="submit"
                            class="btn login-button w-100"
                        >

                            Ingresar al sistema
                            <span>→</span>

                        </button>

                    </form>


                    <div class="login-security">

                        <span>🔐</span>

                        <div>
                            <strong>
                                Acceso protegido
                            </strong>

                            <small>
                                Solo personal autorizado.
                            </small>
                        </div>

                    </div>


                    <div class="login-footer">

                        © <%= new Date().getFullYear() %>
                        TIENDA CAAPA

                    </div>

                </div>

            </div>

        </div>

    </main>


    <script>

        const togglePassword =
            document.getElementById(
                'togglePassword'
            );

        const passwordInput =
            document.getElementById(
                'password'
            );


        if (
            togglePassword &&
            passwordInput
        ) {

            togglePassword.addEventListener(
                'click',
                function () {

                    const isPassword =
                        passwordInput.type
                        === 'password';


                    passwordInput.type =
                        isPassword
                            ? 'text'
                            : 'password';


                    togglePassword.textContent =
                        isPassword
                            ? '🙈'
                            : '👁';

                }
            );

        }

    </script>

</body>

</html>
