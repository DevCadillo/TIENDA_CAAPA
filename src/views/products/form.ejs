<%- include('../partials/header') %>
<div class="mb-4"><h1 class="h3 fw-bold"><%= product && product.id ? 'Editar producto' : 'Nuevo producto' %></h1><a href="/productos">← Volver</a></div>
<% if(error){ %><div class="alert alert-danger"><%= error %></div><% } %>
<div class="card shadow-sm border-0"><div class="card-body p-4"><form method="post" enctype="multipart/form-data" action="<%= product && product.id ? '/productos/'+product.id+'?_method=PUT' : '/productos' %>"><div class="row g-3">
<div class="col-md-4"><label class="form-label">Número / código</label><input class="form-control" name="numero" value="<%= product?.numero || '' %>"></div><div class="col-md-8"><label class="form-label">Nombre *</label><input class="form-control" name="nombre" value="<%= product?.nombre || '' %>" required></div>
<div class="col-md-6"><label class="form-label">Categoría</label><select class="form-select" name="categoria_id"><option value="">Sin categoría</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= String(product?.categoria_id||'')===String(c.id)?'selected':'' %>><%= c.nombre %></option><% }) %></select></div>
<% if(!product?.id){ %><div class="col-md-3"><label class="form-label">Cantidad inicial</label><input class="form-control" type="number" min="0" name="cantidad" value="<%= product?.cantidad ?? 0 %>"></div><% } %><div class="col-md-3"><label class="form-label">Stock mínimo</label><input class="form-control" type="number" min="0" name="stock_minimo" value="<%= product?.stock_minimo ?? 5 %>"></div>
<div class="col-md-6"><label class="form-label">Precio por mayor (Bs)</label><input class="form-control" type="number" step="0.01" min="0" name="precio_mayor" value="<%= product?.precio_mayor ?? 0 %>" required></div><div class="col-md-6"><label class="form-label">Precio unitario (Bs)</label><input class="form-control" type="number" step="0.01" min="0" name="precio_unitario" value="<%= product?.precio_unitario ?? 0 %>" required></div>
<div class="col-md-8"><label class="form-label">Imagen</label><input class="form-control" type="file" name="imagen" accept="image/png,image/jpeg,image/webp,image/gif"><div class="form-text">Máximo 5 MB.</div></div><div class="col-md-4 d-flex align-items-end"><div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" name="disponible" id="disponible" <%= product ? (product.disponible?'checked':'') : 'checked' %>><label class="form-check-label" for="disponible">Disponible</label></div></div>
</div><hr class="my-4"><button class="btn btn-primary">Guardar producto</button> <a class="btn btn-outline-secondary" href="/productos">Cancelar</a></form></div></div>
<%- include('../partials/footer') %>
