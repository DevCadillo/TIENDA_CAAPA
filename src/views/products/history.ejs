<%- include('../partials/header') %>
<div class="mb-4"><h1 class="h3 fw-bold">Historial: <%= product.nombre %></h1><a href="/productos">← Volver a productos</a></div>
<div class="card shadow-sm border-0 mb-4"><div class="card-body"><h2 class="h5">Movimientos de stock</h2><div class="table-responsive"><table class="table"><thead><tr><th>Fecha</th><th>Tipo</th><th>Cantidad</th><th>Anterior</th><th>Nuevo</th><th>Motivo</th><th>Usuario</th></tr></thead><tbody><% movements.forEach(m=>{ %><tr><td><%= new Date(m.creado_en).toLocaleString('es-BO') %></td><td><%= m.tipo %></td><td><%= m.cantidad %></td><td><%= m.stock_anterior %></td><td><%= m.stock_nuevo %></td><td><%= m.motivo || '-' %></td><td><%= m.usuario || '-' %></td></tr><% }) %></tbody></table></div></div></div>
<div class="card shadow-sm border-0"><div class="card-body"><h2 class="h5">Historial de precios</h2><div class="table-responsive"><table class="table"><thead><tr><th>Fecha</th><th>Mayor</th><th>Unitario</th><th>Usuario</th></tr></thead><tbody><% prices.forEach(h=>{ %><tr><td><%= new Date(h.creado_en).toLocaleString('es-BO') %></td><td>Bs <%= Number(h.precio_mayor_anterior).toFixed(2) %> → Bs <%= Number(h.precio_mayor_nuevo).toFixed(2) %></td><td>Bs <%= Number(h.precio_unitario_anterior).toFixed(2) %> → Bs <%= Number(h.precio_unitario_nuevo).toFixed(2) %></td><td><%= h.usuario || '-' %></td></tr><% }) %></tbody></table></div></div></div>
<%- include('../partials/footer') %>
