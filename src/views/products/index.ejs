<%- include('../partials/header') %>
<div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4"><div><h1 class="h3 fw-bold mb-1">Productos</h1><p class="text-secondary mb-0">Consulta inventario, precios y disponibilidad.</p></div>
<% if(user.rol==='admin'){ %><a href="/productos/nuevo" class="btn btn-primary">+ Nuevo producto</a><% } %></div>
<form class="row g-2 mb-4" method="get"><div class="col-md-8"><input id="searchInput" class="form-control form-control-lg" name="q" value="<%= q %>" placeholder="Buscar por nombre o número..."></div><div class="col-md-2"><button class="btn btn-dark btn-lg w-100">Buscar</button></div><div class="col-md-2"><a class="btn btn-outline-secondary btn-lg w-100" href="/productos">Limpiar</a></div></form>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Imagen</th><th>N.º</th><th>Producto</th><th>Categoría</th><th>Stock</th><th>P. mayor</th><th>P. unitario</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
<% if(!products.length){ %><tr><td colspan="9" class="text-center py-5 text-secondary">No se encontraron productos.</td></tr><% } %>
<% products.forEach(p=>{ %><tr class="product-row"><td><% if(p.imagen_url){ %><img src="<%= p.imagen_url %>" class="product-thumb" alt=""><% } else { %><div class="product-placeholder">📦</div><% } %></td><td><%= p.numero || '-' %></td><td class="fw-semibold product-name"><%= p.nombre %></td><td><%= p.categoria || '-' %></td><td><span class="badge text-bg-<%= p.cantidad===0?'danger':(p.cantidad<=p.stock_minimo?'warning':'success') %>"><%= p.cantidad %></span></td><td>Bs <%= Number(p.precio_mayor).toFixed(2) %></td><td>Bs <%= Number(p.precio_unitario).toFixed(2) %></td><td><%= p.disponible ? 'Disponible' : 'No disponible' %></td><td>
<% if(user.rol==='admin'){ %><div class="d-flex flex-wrap gap-1"><a class="btn btn-sm btn-outline-primary" href="/productos/<%= p.id %>/editar">Editar</a><a class="btn btn-sm btn-outline-secondary" href="/productos/<%= p.id %>/historial">Historial</a><button class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#stockModal" data-id="<%= p.id %>" data-name="<%= p.nombre %>">Stock</button>
<form method="post" action="/productos/<%= p.id %>?_method=DELETE" onsubmit="return confirm('¿Eliminar este producto?')"><button class="btn btn-sm btn-outline-danger">Eliminar</button></form></div><% } else { %><span class="text-secondary small">Solo lectura</span><% } %></td></tr><% }) %>
</tbody></table></div></div>
<% if(user.rol==='admin'){ %><div class="modal fade" id="stockModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form id="stockForm" method="post"><div class="modal-header"><h5 class="modal-title">Movimiento de stock</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><p id="stockProduct" class="fw-bold"></p><div class="mb-3"><label class="form-label">Tipo</label><select name="tipo" class="form-select"><option value="entrada">Entrada (+)</option><option value="salida">Salida (-)</option></select></div><div class="mb-3"><label class="form-label">Cantidad</label><input name="cantidad" type="number" min="1" class="form-control" required></div><div><label class="form-label">Motivo</label><input name="motivo" class="form-control" placeholder="Compra, venta, ajuste..."></div></div><div class="modal-footer"><button class="btn btn-primary">Guardar movimiento</button></div></form></div></div></div><% } %>
<%- include('../partials/footer') %>
