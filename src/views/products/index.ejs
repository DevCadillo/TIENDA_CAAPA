<%- include('../partials/header') %>

<div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4 no-print">
    <div>
        <h1 class="h3 fw-bold mb-1">Productos</h1>
        <p class="text-secondary mb-0">
            Consulta inventario, precios y disponibilidad.
        </p>
    </div>

    <% if(user.rol === 'admin'){ %>
        <a href="/productos/nuevo" class="btn btn-primary">
            + Nuevo producto
        </a>
    <% } %>
</div>


<!-- ENCABEZADO SOLO PARA IMPRESIÓN -->
<div class="print-header">
    <h2>TIENDA CAAPA</h2>
    <h4>Reporte de Inventario</h4>
    <p>Productos, precios y existencias disponibles</p>
</div>


<!-- BUSCADOR Y FILTROS -->
<div class="row g-2 mb-4 no-print">

    <div class="col-md-5">
        <input
            id="searchInput"
            class="form-control form-control-lg"
            type="text"
            value="<%= q || '' %>"
            placeholder="Buscar por nombre o número..."
        >
    </div>

    <div class="col-md-3">
        <select
            id="categoryFilter"
            class="form-select form-select-lg"
        >
            <option value="">
                Todas las categorías
            </option>
        </select>
    </div>

    <div class="col-md-2">
        <button
            type="button"
            class="btn btn-dark btn-lg w-100"
            onclick="filterProducts()"
        >
            Buscar
        </button>
    </div>

    <div class="col-md-2">
        <button
            type="button"
            class="btn btn-outline-primary btn-lg w-100"
            onclick="window.print()"
        >
            🖨️ PDF
        </button>
    </div>

</div>


<div class="card shadow-sm border-0">

    <div class="table-responsive">

        <table
            id="productsTable"
            class="table table-hover align-middle mb-0"
        >

            <thead class="table-light">

                <tr>
                    <th>Imagen</th>
                    <th>N.º</th>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th>Stock</th>
                    <th>P. mayor</th>
                    <th>P. unitario</th>
                    <th>Estado</th>
                    <th class="no-print">Acciones</th>
                </tr>

            </thead>

            <tbody>

                <% if(!products.length){ %>

                    <tr>
                        <td
                            colspan="9"
                            class="text-center py-5 text-secondary"
                        >
                            No se encontraron productos.
                        </td>
                    </tr>

                <% } %>


                <% products.forEach(p => { %>

                    <tr class="product-row">

                        <td>

                            <% if(p.imagen_url){ %>

                                <img
                                    src="<%= p.imagen_url %>"
                                    class="product-thumb"
                                    alt="<%= p.nombre %>"
                                >

                            <% } else { %>

                                <div class="product-placeholder">
                                    📦
                                </div>

                            <% } %>

                        </td>


                        <td class="product-number">
                            <%= p.numero || '-' %>
                        </td>


                        <td class="fw-semibold product-name">
                            <%= p.nombre %>
                        </td>


                        <td class="product-category">
                            <%= p.categoria || '-' %>
                        </td>


                        <td>

                            <span
                                class="badge text-bg-<%=
                                    p.cantidad === 0
                                    ? 'danger'
                                    : (
                                        p.cantidad <= p.stock_minimo
                                        ? 'warning'
                                        : 'success'
                                    )
                                %>"
                            >

                                <%= p.cantidad %>

                            </span>

                        </td>


                        <td>
                            Bs <%= Number(p.precio_mayor).toFixed(2) %>
                        </td>


                        <td>
                            Bs <%= Number(p.precio_unitario).toFixed(2) %>
                        </td>


                        <td>

                            <% if(p.disponible){ %>

                                <span class="badge text-bg-success">
                                    Disponible
                                </span>

                            <% } else { %>

                                <span class="badge text-bg-secondary">
                                    No disponible
                                </span>

                            <% } %>

                        </td>


                        <td class="no-print">

                            <% if(user.rol === 'admin'){ %>

                                <div class="d-flex flex-wrap gap-1">

                                    <a
                                        class="btn btn-sm btn-outline-primary"
                                        href="/productos/<%= p.id %>/editar"
                                    >
                                        Editar
                                    </a>


                                    <a
                                        class="btn btn-sm btn-outline-secondary"
                                        href="/productos/<%= p.id %>/historial"
                                    >
                                        Historial
                                    </a>


                                    <button
                                        type="button"
                                        class="btn btn-sm btn-outline-success"
                                        data-bs-toggle="modal"
                                        data-bs-target="#stockModal"
                                        data-id="<%= p.id %>"
                                        data-name="<%= p.nombre %>"
                                    >
                                        Stock
                                    </button>


                                    <form
                                        method="post"
                                        action="/productos/<%= p.id %>?_method=DELETE"
                                        onsubmit="return confirm('¿Eliminar este producto?')"
                                    >

                                        <button
                                            type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                        >
                                            Eliminar
                                        </button>

                                    </form>

                                </div>

                            <% } else { %>

                                <span class="text-secondary small">
                                    Solo lectura
                                </span>

                            <% } %>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>


<!-- MODAL DE STOCK -->
<% if(user.rol === 'admin'){ %>

    <div
        class="modal fade"
        id="stockModal"
        tabindex="-1"
    >

        <div class="modal-dialog">

            <div class="modal-content">

                <form
                    id="stockForm"
                    method="post"
                >

                    <div class="modal-header">

                        <h5 class="modal-title">
                            Movimiento de stock
                        </h5>

                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                        ></button>

                    </div>


                    <div class="modal-body">

                        <p
                            id="stockProduct"
                            class="fw-bold"
                        ></p>


                        <div class="mb-3">

                            <label class="form-label">
                                Tipo
                            </label>

                            <select
                                name="tipo"
                                class="form-select"
                            >

                                <option value="entrada">
                                    Entrada (+)
                                </option>

                                <option value="salida">
                                    Salida (-)
                                </option>

                            </select>

                        </div>


                        <div class="mb-3">

                            <label class="form-label">
                                Cantidad
                            </label>

                            <input
                                name="cantidad"
                                type="number"
                                min="1"
                                class="form-control"
                                required
                            >

                        </div>


                        <div>

                            <label class="form-label">
                                Motivo
                            </label>

                            <input
                                name="motivo"
                                class="form-control"
                                placeholder="Compra, venta, ajuste..."
                            >

                        </div>

                    </div>


                    <div class="modal-footer">

                        <button
                            type="submit"
                            class="btn btn-primary"
                        >
                            Guardar movimiento
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

<% } %>


<%- include('../partials/footer') %>